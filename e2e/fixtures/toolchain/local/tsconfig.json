{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "plugins": [
            {
                "transform": "typescript-transform-paths",
                "afterDeclarations": true
            }
        ],
        "strict": true,
        "target": "ES2022"
    },
    "include": ["src/**/*.ts"]
}
